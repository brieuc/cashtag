<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!-- Create recurrency table -->
    <changeSet id="10" author="Brieuc">
        <createTable tableName="recurrency">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="modification_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="frequency" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="recurrency"
                                 baseColumnNames="currency_code"
                                 constraintName="fk_recurrency_currency"
                                 referencedTableName="currency"
                                 referencedColumnNames="code"
                                 onDelete="RESTRICT"/>
    </changeSet>

    <!-- Create recurrency_tag junction table -->
    <changeSet id="11" author="Brieuc">
        <createTable tableName="recurrency_tag">
            <column name="recurrency_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tag_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="recurrency_tag"
                       columnNames="recurrency_id, tag_id"
                       constraintName="pk_recurrency_tag"/>

        <addForeignKeyConstraint baseTableName="recurrency_tag"
                                 baseColumnNames="recurrency_id"
                                 constraintName="fk_recurrency_tag_recurrency"
                                 referencedTableName="recurrency"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="recurrency_tag"
                                 baseColumnNames="tag_id"
                                 constraintName="fk_recurrency_tag_tag"
                                 referencedTableName="tag"
                                 referencedColumnNames="id"
                                 onDelete="RESTRICT"/>
    </changeSet>

</databaseChangeLog>
