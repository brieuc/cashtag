<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!-- Create TagGroup table -->
    <changeSet id="15" author="Brieuc">
        <createTable tableName="tag_group">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="usage_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="last_used" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Create TagGroup-Tag junction table (Many-to-Many relationship) -->
    <changeSet id="16" author="Brieuc">
        <createTable tableName="tag_group_tag">
            <column name="tag_group_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tag_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="tag_group_tag"
                       columnNames="tag_group_id, tag_id"
                       constraintName="pk_tag_group_tag"/>

        <addForeignKeyConstraint baseTableName="tag_group_tag"
                                 baseColumnNames="tag_group_id"
                                 constraintName="fk_tag_group_tag_group"
                                 referencedTableName="tag_group"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="tag_group_tag"
                                 baseColumnNames="tag_id"
                                 constraintName="fk_tag_group_tag_tag"
                                 referencedTableName="tag"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <!-- Create TagGroupTitleSuggestion table -->
    <changeSet id="17" author="Brieuc">
        <createTable tableName="tag_group_title_suggestion">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tag_group_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="usage_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="last_used" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="tag_group_title_suggestion"
                                 baseColumnNames="tag_group_id"
                                 constraintName="fk_tag_group_title_suggestion_group"
                                 referencedTableName="tag_group"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
