<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!-- Change recurrency.start_date from DATE to DATETIME -->
    <changeSet id="12" author="Brieuc">
        <modifyDataType tableName="recurrency"
                        columnName="start_date"
                        newDataType="DATETIME"/>
    </changeSet>

    <!-- Change entry.accounting_date from TIMESTAMP to DATETIME to avoid timezone conversion issues -->
    <changeSet id="13" author="Brieuc">
        <modifyDataType tableName="entry"
                        columnName="accounting_date"
                        newDataType="DATETIME"/>
    </changeSet>

    <!-- Change recurrency.modification_date from TIMESTAMP to DATETIME to avoid timezone conversion issues -->
    <changeSet id="14" author="Brieuc">
        <modifyDataType tableName="recurrency"
                        columnName="modification_date"
                        newDataType="DATETIME"/>
    </changeSet>

</databaseChangeLog>
